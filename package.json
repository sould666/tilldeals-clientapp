{
  "name": "tilldeals-clientapp",
  "version": "0.9.19",
  "private": true,
  "description": "Local desktop hardware overview",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win dir --x64",
    "package:installer": "electron-builder --win nsis --x64 --publish never",
    "deploy:win": "node scripts/deploy-win.js",
    "test:sensors": "node scripts/test-sensors.js"
  },
  "dependencies": {
    "systeminformation": "^5.33.8"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tilldeals.hardware",
    "productName": "TillDeals Hardware",
    "icon": "build/icon.ico",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}-win-${arch}.${ext}"
    },
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  }
}
