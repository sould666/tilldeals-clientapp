{
  "name": "tilldeals-clientapp",
  "version": "1.0.0",
  "private": true,
  "description": "Local desktop hardware overview",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win dir --x64",
    "package:installer": "electron-builder --win nsis --x64 --publish never",
    "test:sensors": "node scripts/test-sensors.js",
    "test:backend": "node --test scripts/backend.test.js scripts/account.test.js scripts/auth.test.js scripts/tracked-sync.test.js",
    "test:updates": "node --test scripts/updates.test.js scripts/release-version.test.js"
  },
  "dependencies": {
    "systeminformation": "^5.33.8",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^37.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tilldeals.hardware",
    "productName": "TillDeals Hardware",
    "icon": "build/icon.ico",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "sould666",
      "repo": "tilldeals-clientapp",
      "releaseType": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "TillDeals-Hardware-Setup-${version}-win-${arch}.${ext}"
    },
    "artifactName": "${productName}-${version}-win-${arch}.${ext}"
  }
}
